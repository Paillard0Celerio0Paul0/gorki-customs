// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  clips    Clip[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Game {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  blueTeam    Team     @relation("BlueTeam")
  redTeam     Team     @relation("RedTeam")
  blueScore   Int      @default(0)
  redScore    Int      @default(0)
  winner      TeamSide
  duration    Int? // en minutes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clips       Clip[]
  picksBans   PickBan[]
  statistics  Statistic[]
}

model Team {
  id        String   @id @default(cuid())
  name      String
  side      TeamSide
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  players   Player[]
}

model Player {
  id          String   @id @default(cuid())
  pseudo      String
  role        Role
  champion    String
  kills       Int      @default(0)
  deaths      Int      @default(0)
  assists     Int      @default(0)
  cs          Int      @default(0) // Creep Score
  gold        Int      @default(0)
  damage      Int      @default(0)
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  statistics  Statistic[]
}

model PickBan {
  id        String     @id @default(cuid())
  champion  String
  type      PickBanType
  team      TeamSide
  order     Int
  gameId    String
  game      Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model Statistic {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  kills     Int
  deaths    Int
  assists   Int
  cs        Int
  gold      Int
  damage    Int
  visionScore Int    @default(0)
  wardsPlaced Int   @default(0)
  wardsDestroyed Int @default(0)
}

model Clip {
  id        String   @id @default(cuid())
  title     String
  blobUrl   String
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  uploaderId String?
  uploader  User?    @relation(fields: [uploaderId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  USER
  TOP
  JUNGLE
  MID
  ADC
  SUPPORT
}

enum TeamSide {
  BLUE
  RED
}

enum PickBanType {
  PICK
  BAN
}